        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    namespace kontrak {\n        class DapatDipinjam {\n            &lt;&lt;interface&gt;&gt;\n            +bisaDipinjam() boolean\n        }\n        class AturanDenda {\n            &lt;&lt;interface&gt;&gt;\n            +hitung(aset: Aset, hariTerlambat: int) long\n        }\n    }\n    namespace model {\n        class Aset {\n            &lt;&lt;abstract&gt;&gt;\n            -kode: String\n            -nama: String\n            -status: StatusAset\n            -kondisi: Kondisi\n            +Aset(kode: String, nama: String)\n            +bisaDipinjam() boolean\n            +getJenis() JenisAset\n            +hitungDenda(hariTerlambat: int)* long\n        }\n        class Ruang {\n            -kapasitas: int\n            +getJenis() JenisAset\n            +hitungDenda(hariTerlambat: int) long\n        }\n        class Laptop {\n            -spesifikasi: String\n            -nomorInventaris: String\n            +getJenis() JenisAset\n            +hitungDenda(hariTerlambat: int) long\n        }\n        class AlatLab {\n            -laboratorium: String\n            -tingkatRisiko: TingkatRisiko\n            +getJenis() JenisAset\n            +hitungDenda(hariTerlambat: int) long\n        }\n        class Peminjam {\n            &lt;&lt;record&gt;&gt;\n            +id() String\n            +nama() String\n        }\n        class Peminjaman {\n            -id: String\n            -peminjam: Peminjam\n            -aset: Aset\n            -mulai: LocalDateTime\n            -selesai: LocalDateTime\n            -status: StatusPeminjaman\n        }\n    }\n    namespace katalog {\n        class KatalogAset {\n            -daftar: List~Aset~\n            +tambah(aset: Aset) void\n            +semua() List~Aset~\n            +cari(kata: String) List~Aset~\n            +cari(kata: String, jenis: JenisAset) List~Aset~\n        }\n    }\n    namespace denda {\n        class DendaFlat {\n            +hitung(aset: Aset, hariTerlambat: int) long\n        }\n        class DendaProgresif {\n            +hitung(aset: Aset, hariTerlambat: int) long\n        }\n    }\n    namespace jadwal {\n        class JadwalPeminjaman {\n            -daftar: List~Peminjaman~\n            -kuotaLaptop: int\n            +tambah(p: Peminjaman) void\n            +bentrok(baru: Peminjaman) boolean\n            +ajukan(baru: Peminjaman) void\n        }\n    }\n\n    DapatDipinjam &lt;|.. Aset\n    Aset &lt;|-- Ruang\n    Aset &lt;|-- Laptop\n    Aset &lt;|-- AlatLab\n    AturanDenda &lt;|.. DendaFlat\n    AturanDenda &lt;|.. DendaProgresif\n    KatalogAset o-- \&quot;0..*\&quot; Aset\n    DendaFlat ..&gt; Aset\n    DendaProgresif ..&gt; Aset\n    Peminjaman \&quot;*\&quot; --&gt; \&quot;1\&quot; Peminjam\n    Peminjaman \&quot;*\&quot; --&gt; \&quot;1\&quot; Aset\n    JadwalPeminjaman o-- \&quot;0..*\&quot; Peminjaman&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nED2Ub5Oxac4wgThPPYZ-1">
